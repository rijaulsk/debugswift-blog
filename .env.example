# DebugSwift Blog — environment
#
# Copy to .env.local and fill in. Nothing here is committed except this file.
#
# THE ONE RULE THAT MATTERS: while NEXT_PUBLIC_SANITY_PROJECT_ID is EMPTY, the
# blog renders the local content in content/ so the app runs on a fresh clone
# with no accounts. The moment it has a value, Sanity becomes the only source of
# truth and an empty dataset renders an empty blog — it never silently falls
# back and pretends the CMS is working. See lib/env.ts.

# --- Sanity (content) ---------------------------------------------------------
# From sanity.io/manage → your project → API.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Pinned API date. Bump deliberately, never set to "latest".
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# Editor-role token. LOCAL AND SERVER ONLY — never NEXT_PUBLIC_, never in the
# browser bundle. Used by `npm run seed` and by the guest-pitch endpoints, which
# write documents on the reader's behalf.
SANITY_API_WRITE_TOKEN=

# --- Cloudinary (media) -------------------------------------------------------
# Just the cloud name; delivery URLs are public by design. Uploads happen inside
# the Studio via sanity-plugin-cloudinary, so no API secret belongs here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Revalidation -------------------------------------------------------------
# Any long random string. Set the same value on the Sanity webhook so publishing
# a post refreshes the static pages immediately instead of waiting for a rebuild.
# Point the webhook at the Vercel origin directly, NOT at debugswift.com/blog —
# a webhook has no reason to take the proxy hop.
REVALIDATE_SECRET=
