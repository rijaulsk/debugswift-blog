# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit a real one. `.env.example` is the exception and is
# tracked on purpose: it documents which keys a deploy needs (WEB3FORMS_ACCESS_KEY
# etc.) without carrying a single value.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Strategy briefs live in chats, NEVER in the repo (brief v5's own rule) � they carry internal pricing.
debugswift-master-brief-v*.md

# Playwright / MCP browser artifacts (console logs, page snapshots, reports)
/.playwright-mcp/
/test-results/
/playwright-report/

# Editor & OS cruft
Thumbs.db
desktop.ini
.idea/
.vscode/
*~

# Loose images / video / scratch dropped at the repo ROOT (design references,
# AI exports, screenshots). Real site assets live under /public and are NOT
# matched by these root-only globs.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
/*.mp4
/*.pdf

# Internal / working material — NOT part of the website build. Vercel ignores
# these anyway; this keeps them out of the git remote. Local copies are kept
# (removed with `git rm --cached`), so the Claude Code hooks/rules and the docs
# still work on this machine — they're just no longer pushed or version-shared.
/.claude/
/CLAUDE.md
/AGENTS.md
/docs/
/debugswift-assets/

# Sanity
/.sanity/
/dist/
sanity.types.ts

